{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered or guest user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "hasBeastBoat": { "type": "boolean" }
      },
      "required": ["uid", "name"]
    },
    "Fruit": {
      "title": "Fruit",
      "description": "Devil fruit or game pass item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "photo": { "type": "string" },
        "rarity": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["name", "value", "photo", "rarity"]
    },
    "Trade": {
      "title": "Trade",
      "description": "Trade listing posted by a user",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "username": { "type": "string" },
        "offering": { "type": "array" },
        "wanting": { "type": "object" },
        "status": { "type": "string" },
        "closedWith": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["ownerId", "username", "offering", "status"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Counter offer or direct accept offer on a trade",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "tradeId": { "type": "string" },
        "username": { "type": "string" },
        "type": { "type": "string" },
        "offering": { "type": "array" },
        "note": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["ownerId", "tradeId", "username", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/fruits/{fruitId}": {
      "schema": "Fruit",
      "description": "Catalog of fruits managed by admin"
    },
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "List of active and closed trade offers"
    },
    "/offers/{offerId}": {
      "schema": "Offer",
      "description": "Offers submitted for trades"
    }
  }
}
